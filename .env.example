# Request the "Road traffic - traffic situations" token from:
# https://api-manager.opentransportdata.swiss/portal/catalogue-products/tedp_road_traffic_traffic_situations_policy-1
opentransportdata_api_key=replace-with-your-bearer-token

# Optional. The server defaults to port 3001.
PORT=3001

# Listen on all network interfaces so other hosts can connect.
HOST=0.0.0.0

# Comma-separated frontend origins, or * to allow every origin.
CORS_ALLOWED_ORIGINS=*

# Optional. Limits upstream ASTRA calls to one per interval. Defaults to 180 seconds.
ASTRA_CACHE_TTL_SECONDS=180

# Optional. Set this when the frontend and API are deployed on different hosts.
# This value is public and is embedded in the frontend build.
VITE_API_BASE_URL=
